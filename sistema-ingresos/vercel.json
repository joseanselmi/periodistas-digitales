{
  "buildCommand": null,
  "outputDirectory": ".",
  "framework": null,
  "functions": {
    "api/wa-funnel.js": { "maxDuration": 60 },
    "api/recuperacion.js": { "maxDuration": 60 },
    "api/hotmart-sync.js": { "maxDuration": 60 },
    "api/salud.js": { "maxDuration": 30 }
  },
  "crons": [
    { "path": "/api/wa-funnel", "schedule": "0 13 * * *" },
    { "path": "/api/recuperacion", "schedule": "0 15 * * *" }
  ],
  "rewrites": [
    { "source": "/gracias", "destination": "/gracias.html" }
  ]
}
